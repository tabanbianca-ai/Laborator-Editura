{
  "name": "laboratorul-editurii",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "staging:backup": "node deploy/staging/scripts/backup-staging.mjs",
    "staging:bootstrap": "node deploy/staging/scripts/bootstrap-admin-reviewer.mjs",
    "staging:deploy": "bash deploy/staging/scripts/deploy-staging.sh",
    "staging:docker:down": "docker compose --env-file deploy/staging/.env.staging -f deploy/staging/docker-compose.staging.yml down",
    "staging:docker:up": "docker compose --env-file deploy/staging/.env.staging -f deploy/staging/docker-compose.staging.yml up -d --build",
    "staging:health": "node deploy/staging/scripts/health-check.mjs",
    "staging:logs": "bash deploy/staging/scripts/logs-staging.sh",
    "staging:logs:api": "bash deploy/staging/scripts/logs-staging.sh api",
    "staging:logs:web": "bash deploy/staging/scripts/logs-staging.sh web",
    "staging:monitor": "node deploy/staging/scripts/monitoring-hook.mjs",
    "staging:restore:dry-run": "node deploy/staging/scripts/restore-dry-run.mjs",
    "staging:smoke": "node deploy/staging/scripts/staging-smoke-test.mjs",
    "staging:validate": "node deploy/staging/scripts/validate-staging.mjs",
    "staging:validate-env": "node deploy/staging/scripts/validate-env.mjs",
    "infra:validate": "bash infrastructure/validation/validate-infrastructure.sh",
    "infra:scan-secrets": "bash infrastructure/validation/scan-secrets.sh",
    "infra:backup:dry-run": "bash infrastructure/backup/backup-laborator.sh --config infrastructure/backup/laborator-backup.env.example --dry-run",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check .github/workflows/ci.yml package.json scripts/validate-configuration.mjs apps/api/src/modules/health.controller.ts apps/api/src/modules/auth/request-context.middleware.ts apps/api/tests/foundation-ci-security-contract.test.mjs apps/api/tests/foundation-health-contract.test.mjs packages/shared/package.json packages/shared/scripts/ensure-esm-file-exports.mjs packages/shared/src/index.ts packages/shared/src/configuration.ts packages/shared/src/errors.ts packages/shared/src/localization.ts packages/shared/src/structured-logging.ts packages/shared/tests/foundation-contract.test.mjs 'packages/shared/locales/*/common.json'",
    "validate:config": "node scripts/validate-configuration.mjs",
    "check": "pnpm validate:config && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
