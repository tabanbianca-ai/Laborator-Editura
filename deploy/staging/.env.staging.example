# Copy this file to deploy/staging/.env.staging and replace placeholder values.
# Do not commit deploy/staging/.env.staging.

COMPOSE_PROJECT_NAME=laborator-staging

# Next.js and Node use standard NODE_ENV values. APP_ENV preserves staging
# semantics for security validation and operator scripts.
NODE_ENV=production
APP_ENV=staging

# Host ports exposed by Docker Compose.
STAGING_API_PORT=3001
STAGING_WEB_PORT=3000

# Runtime ports inside containers.
API_PORT=3001
WEB_PORT=3000

# Public staging origins.
WEB_ORIGIN=http://localhost:3000
API_BASE=http://localhost:3001
STAGING_WEB_ORIGIN=http://localhost:3000

# Server-side web API base. In Docker Compose this should use the API service name.
API_BASE_URL=http://api:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Runtime database and backup paths inside the API container.
LABORATOR_RUNTIME_DB_PATH=/var/lib/laborator/runtime-db.json
STAGING_BACKUP_DIR=/var/backups/laborator/staging
STAGING_BACKUP_MODE=docker
STAGING_ENV_FILE=deploy/staging/.env.staging
STAGING_COMPOSE_FILE=deploy/staging/docker-compose.staging.yml

# Required staging secrets. Replace with high-entropy values before deployment.
# Use at least 32 characters and do not use demo/default/example values.
LABORATOR_SESSION_SECRET=replace-with-random-32-plus-character-session-value
LABORATOR_AUTH_LOGIN_SECRET=replace-with-random-32-plus-character-login-value

# Operator-side restore dry-run target.
STAGING_RESTORE_DB_PATH=/tmp/laborator-staging-restore/runtime-db.json

# Server-side reviewer/admin bootstrap values for closed beta validation.
STAGING_REVIEWER_EMAIL=beta-reviewer@example.com
STAGING_REVIEWER_NAME=BetaReviewer
STAGING_ORGANIZATION_NAME=ClosedBetaOrganization
STAGING_BOOTSTRAP_ROLE=REVIEWER
