# Non-secret staging inventory example.
# Copy values into /etc/laborator/infrastructure.env and GitHub Actions Secrets
# where appropriate. Do not store real private keys here.

VPS_HOST=example.invalid
VPS_PORT=22
VPS_USER=deploy
DEPLOY_PATH=/opt/laborator-editura
STAGING_WEB_URL=http://example.invalid
STAGING_API_HEALTH_URL=http://127.0.0.1:3001/health
APP_ENV=staging
NODE_ENV=production
