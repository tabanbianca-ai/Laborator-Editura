# Copy to /etc/laborator/infrastructure.env and edit on the VPS.
# Do not commit real secrets or private paths containing credentials.

CONFIG_DIR=/etc/laborator
PROJECT_ROOT=/opt/laborator-editura
APP_ROOT=/opt/laborator-editura
DOCKER_COMPOSE_PATH=/opt/laborator-editura/deploy/staging/docker-compose.staging.yml
COMPOSE_FILE=/opt/laborator-editura/deploy/staging/docker-compose.staging.yml
ARTIFACT_COMPOSE_FILE=/opt/laborator-editura/deploy/staging/docker-compose.artifact.yml
ENV_FILE=/opt/laborator-editura/deploy/staging/.env.staging
STAGING_RELEASES_DIR=/opt/laborator-editura/.releases/staging
STAGING_RELEASE_IDENTITY_FILE=/opt/laborator-editura/.releases/staging/current/release-identity.json
BACKUP_DIR=/opt/laborator-backups
BACKUP_ROOT=/opt/laborator-backups
LOG_DIR=/var/log/laborator
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_FREE_MB=1024
BACKUP_LOCK_DIR=/tmp/laborator-backup.lock

DOCKER_PROJECT_NAME=laborator-staging
RUNTIME_DB_VOLUME=laborator-staging_runtime-db
RUNTIME_BACKUPS_VOLUME=laborator-staging_runtime-backups

NGINX_DIR=/etc/nginx
NGINX_CONFIG_DIR=/etc/nginx
SYSTEMD_DIR=/etc/systemd/system
SYSTEMD_CONFIG_DIR=/etc/systemd/system

# Keep false unless the backup storage is encrypted and access is restricted.
BACKUP_INCLUDE_ENV=false

# Optional encryption. Supported values: none, age, gpg.
BACKUP_ENCRYPTION=none
AGE_RECIPIENT=
GPG_RECIPIENT=

# Optional external copy via rclone. Credentials live outside the repo.
RCLONE_REMOTE=
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
