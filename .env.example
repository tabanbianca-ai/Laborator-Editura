# Laborator Editura local environment example.
# Copy to .env for local development only. Never commit real .env files.

NODE_ENV=development
APP_ENV=local

API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_BASE=http://localhost:3001
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Replace before using shared sessions outside local development.
LABORATOR_SESSION_SECRET=replace-with-random-32-plus-character-session-value
LABORATOR_AUTH_LOGIN_SECRET=replace-with-random-32-plus-character-login-value

LABORATOR_RUNTIME_DB_PATH=.data/runtime-db.json

# External manuscript processing is fail-closed. Enabling it still requires
# explicit user authorization for each AI translation proposal.
AI_EXTERNAL_PROCESSING_ENABLED=false
AI_PROVIDER_TIMEOUT_MS=20000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TRANSLATION_MODEL=claude-sonnet-4-5
