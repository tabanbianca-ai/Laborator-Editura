{
  "name": "@laborator/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json-master-format": {
      "types": "./dist/json-master-format/index.d.ts",
      "default": "./dist/json-master-format/index.js"
    },
    "./language-policy": {
      "types": "./dist/language-policy.d.ts",
      "default": "./dist/language-policy.js"
    },
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "default": "./dist/configuration.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./localization": {
      "types": "./dist/localization.d.ts",
      "default": "./dist/localization.js"
    },
    "./structured-logging": {
      "types": "./dist/structured-logging.d.ts",
      "default": "./dist/structured-logging.js"
    },
    "./canonical-data": {
      "types": "./dist/canonical-data.d.ts",
      "default": "./dist/canonical-data.js"
    },
    "./editorial-core": {
      "types": "./dist/editorial-core.d.ts",
      "default": "./dist/editorial-core.js"
    },
    "./unified-library": {
      "types": "./dist/unified-library.d.ts",
      "default": "./dist/unified-library.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/ensure-esm-file-exports.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
